{
  "name": "whiteboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "cloud:check": "tsc -p worker/tsconfig.json",
    "cloud:dev": "npm run build && wrangler dev",
    "cloud:deploy": "npm run build && npm run cloud:check && wrangler deploy",
    "cloud:password": "node scripts/cloud-password.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.160.0"
  }
}
