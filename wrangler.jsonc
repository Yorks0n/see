{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "see-whiteboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-10",
  "assets": {
    "directory": "./dist",
    "binding": "SITE",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "VAULT", "class_name": "SeeVault" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SeeVault"] }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "see-whiteboard-media" }],
  "vars": {
    "USERNAME": "owner",
    "ALLOWED_ORIGIN": "https://yorks0n.github.io"
  }
}
